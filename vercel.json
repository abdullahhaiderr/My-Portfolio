{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/admin/login/?$",
      "dest": "/admin/login.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/admin/(?:overview|projects|profile|certifications|inbox|media)/?$",
      "dest": "/admin/index.html"
    }
  ]
}
